# ==============================================================================
# LazyLayers Cache - Complete Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EVENT BUS & REMOTE STORAGE SERVICES
# ------------------------------------------------------------------------------
# Redis connection URL (used for L2 Cache, Distributed Locks, and RedisEventBus)
REDIS_URL=redis://127.0.0.1:6389

# RabbitMQ AMQP connection URL (used for RabbitMQEventBus)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673

# NATS server connection URL (used for NatsEventBus - Core and JetStream modes)
NATS_URL=nats://127.0.0.1:4223

# Docker Compose Port Mappings (if running via docker-compose.yml)
REDIS_PORT=6389
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
NATS_PORT=4223
NATS_HTTP_PORT=8223

# ------------------------------------------------------------------------------
# 2. OBSERVABILITY DASHBOARD & PROMETHEUS METRICS
# ------------------------------------------------------------------------------
# Enable the built-in live web dashboard (default: false in production, true in examples)
LAZY_OBS_ENABLED=true

# Dashboard base route (default: /__lazylayers, with /observelazyily supported as alias)
LAZY_OBS_ROUTE=/__lazylayers

# Standalone dashboard server binding (default: 127.0.0.1 : 7077)
LAZY_OBS_HOST=127.0.0.1
LAZY_OBS_PORT=7077

# Dashboard Authentication Credentials (HTTP Basic Auth)
LAZY_OBS_USER=lazydev
LAZY_OBS_PASSWORD=lazydev

# Optional Bearer token authentication (alternative to Basic Auth)
# LAZY_OBS_TOKEN=your-secure-telemetry-token-here

# Silence the console startup notice in production (default: false)
LAZY_OBS_QUIET=false

# Prometheus Metrics Scrape Settings
LAZY_PROMETHEUS_ENABLED=true
LAZY_PROMETHEUS_PREFIX=lazycache
LAZY_PROMETHEUS_PUBLIC=true

# ------------------------------------------------------------------------------
# 3. CACHE CORE DEFAULTS & TTL HIERARCHY
# ------------------------------------------------------------------------------
# Global default TTL in milliseconds (default: 60000 = 60s)
LAZY_CACHE_TTL_MS=60000

# L1 In-Memory LRU Maximum Entries before eviction (default: 10000)
LAZY_L1_MAX_ENTRIES=10000

# L1 Memory Store TTL (default: 60000 = 60s)
LAZY_L1_TTL_MS=60000

# L2 Redis Key Prefix (default: lazylayers:)
LAZY_L2_PREFIX=lazylayers:

# L2 Redis TTL (default: 600000 = 10m)
LAZY_L2_TTL_MS=600000

# L2 Redis Delete Strategy ('unlink' for non-blocking memory free, 'del' for synchronous)
LAZY_L2_DELETE_STRATEGY=unlink

# ------------------------------------------------------------------------------
# 4. IN-FLIGHT DEDUPE & STAMPEDE (THUNDERING HERD) PROTECTION
# ------------------------------------------------------------------------------
# Maximum duration an in-flight promise lock is retained (default: 15000 = 15s)
LAZY_INFLIGHT_TTL_MS=15000

# Distributed Lock TTL for multi-node cluster stampede defense (default: 5000 = 5s)
LAZY_DIST_LOCK_TTL_MS=5000

# Distributed Lock wait timeout before falling back (default: 8000 = 8s)
LAZY_DIST_LOCK_WAIT_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 5. RESILIENCE, CIRCUIT BREAKER & FAIL-SAFE STALE
# ------------------------------------------------------------------------------
# Number of consecutive failures before tripping Circuit Breaker OPEN (default: 3)
LAZY_CIRCUIT_BREAKER_FAILURES=3

# Time to wait before attempting recovery probe in HALF-OPEN (default: 10000 = 10s)
LAZY_CIRCUIT_BREAKER_RESET_MS=10000

# Fail-Safe Stale TTL: How long stale L1 values are kept during DB outages (default: 300000 = 5m)
LAZY_FAILSAFE_STALE_TTL_MS=300000

# Negative Caching TTL for 404 / null DB lookups (default: 10000 = 10s)
LAZY_NEGATIVE_CACHE_TTL_MS=10000

# Loader Soft Timeout (serves stale value if available without aborting loader)
LAZY_LOADER_SOFT_TIMEOUT_MS=500

# Loader Hard Timeout (aborts loader via AbortSignal and fails/stales)
LAZY_LOADER_HARD_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 6. SERIALIZATION & SIZE-TIERED WIRE COMPRESSION
# ------------------------------------------------------------------------------
# Force plain JSON serialization for debugging (default: false -> uses MsgPack/LZ4/Zstd)
CACHE_DEBUG_SERIALIZATION=false

# Compression Savings Threshold (minimum fractional savings required to keep compressed buffer)
LAZY_COMPRESSION_SAVINGS_THRESHOLD=0.15

# Small-value compression floor in bytes (payloads below this are stored as raw MsgPack)
LAZY_COMPRESSION_MIN_BYTES=256

# ------------------------------------------------------------------------------
# 7. MULTI-SERVER CLUSTER NODES (SIMULATION CONFIG)
# ------------------------------------------------------------------------------
NODE1_HTTP_PORT=3001
NODE1_OBS_PORT=7071

NODE2_HTTP_PORT=3002
NODE2_OBS_PORT=7072

NODE3_HTTP_PORT=3003
NODE3_OBS_PORT=7073
