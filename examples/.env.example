# ==============================================================================
# LazyLayers Examples - Environment Configuration Template
# ==============================================================================

# Remote Event Bus & Storage Services
REDIS_URL=redis://127.0.0.1:6389
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673
NATS_URL=nats://127.0.0.1:4223

# Observability Dashboard & Auth
LAZY_OBS_ENABLED=true
LAZY_OBS_USER=lazydev
LAZY_OBS_PASSWORD=lazydev
LAZY_OBS_PORT=7077

# Multi-Node Example Ports
NODE1_PORT=3001
NODE2_PORT=3002
NODE3_PORT=3003
