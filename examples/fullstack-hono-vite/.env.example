# ==============================================================================
# LazyLayers Fullstack (Hono.js + Vite.js) Configuration
# ==============================================================================

# Backend API Port
PORT=3000

# Redis Connection (L2 Cache + Distributed Lock)
REDIS_URL=redis://127.0.0.1:6389

# RabbitMQ & NATS Connections (Multi-Server Event Bus Invalidation)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5673
NATS_URL=nats://127.0.0.1:4223

# Built-in Observability Dashboard
LAZY_OBS_PORT=7077
LAZY_OBS_USER=lazydev
LAZY_OBS_PASSWORD=lazydev
LAZY_OBS_ROUTE=/__lazylayers
LAZY_PROMETHEUS_PUBLIC=true
