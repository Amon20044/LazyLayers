{
  "name": "lazylayers-fullstack-hono-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --loader ts-node/esm --no-warnings server/index.ts || tsx server/index.ts || node server/index.js",
    "dev:client": "vite --port 5175",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "node --import tsx server/index.ts",
    "start:client": "vite --port 5175"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
