{
  "name": "lazy-layers-cache",
  "version": "0.5.0",
  "description": "A TypeScript hybrid L1/L2 cache with lazy loading, inflight dedupe, event-bus invalidation, cross-instance L1 priming, and a live observability dashboard with Prometheus + OpenTelemetry.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist-cjs/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus/index.d.ts",
      "import": "./dist/event-bus/index.js",
      "require": "./dist-cjs/event-bus/index.js",
      "default": "./dist/event-bus/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "require": "./dist-cjs/cache/index.js",
      "default": "./dist/cache/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "require": "./dist-cjs/observability/index.js",
      "default": "./dist/observability/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "20 || >=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.cjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-cjs', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run ci",
    "ci": "npm run clean && npm run typecheck && npm run build && npm test",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "cache",
    "caching",
    "hybrid-cache",
    "multi-level-cache",
    "l1-cache",
    "l2-cache",
    "in-memory-cache",
    "redis-cache",
    "distributed-cache",
    "cache-layer",
    "cache-invalidation",
    "pubsub",
    "event-driven",
    "event-bus",
    "message-queue",
    "rabbitmq",
    "redis",
    "lru-cache",
    "ttl-cache",
    "node-cache",
    "nodejs",
    "typescript",
    "performance",
    "low-latency",
    "high-performance",
    "scalable",
    "microservices",
    "backend",
    "infrastructure",
    "system-design",
    "thundering-herd",
    "cache-stampede",
    "request-coalescing",
    "read-through-cache",
    "fail-open",
    "observability",
    "metrics",
    "dashboard",
    "prometheus",
    "opentelemetry",
    "telemetry",
    "diagnostics-channel",
    "cache-dashboard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "amqplib": "^2.0.1",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "msgpackr": "^2.0.5"
  },
  "optionalDependencies": {
    "lz4-napi": "^2.9.0",
    "snappy": "^7.2.2"
  }
}
