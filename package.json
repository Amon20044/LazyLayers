{
  "name": "lazy-layers-cache",
  "version": "0.1.0a",
  "description": "A TypeScript hybrid cache with L1/L2 storage, lazy loading, inflight dedupe, and event-bus invalidation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist-cjs/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus/index.d.ts",
      "import": "./dist/event-bus/index.js",
      "require": "./dist-cjs/event-bus/index.js",
      "default": "./dist/event-bus/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "require": "./dist-cjs/cache/index.js",
      "default": "./dist/cache/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.cjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('dist-cjs', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "cache",
    "caching",
    "hybrid-cache",
    "multi-level-cache",
    "l1-cache",
    "l2-cache",
    "in-memory-cache",
    "redis-cache",
    "distributed-cache",
    "cache-layer",
    "cache-invalidation",
    "pubsub",
    "event-driven",
    "event-bus",
    "message-queue",
    "rabbitmq",
    "redis",
    "lru-cache",
    "ttl-cache",
    "node-cache",
    "nodejs",
    "typescript",
    "performance",
    "low-latency",
    "high-performance",
    "scalable",
    "microservices",
    "backend",
    "infrastructure",
    "system-design",
    "thundering-herd",
    "cache-stampede",
    "request-coalescing",
    "read-through-cache",
    "fail-open",
    "observability",
    "metrics"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/buffers": "^0.1.34",
    "amqplib": "^1.0.3",
    "ioredis": "^5.10.1",
    "lru-cache": "^11.3.5",
    "msgpackr": "^1.11.10",
    "nats": "^2.29.3"
  }
}
