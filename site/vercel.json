{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://documentation-liard-two.vercel.app/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://documentation-liard-two.vercel.app/docs/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://documentation-liard-two.vercel.app/_next/:path*"
    },
    {
      "source": "/api/search",
      "destination": "https://documentation-liard-two.vercel.app/api/search"
    },
    {
      "source": "/api/chat",
      "destination": "https://documentation-liard-two.vercel.app/api/chat"
    },
    {
      "source": "/og/:path*",
      "destination": "https://documentation-liard-two.vercel.app/og/:path*"
    },
    {
      "source": "/llms.txt",
      "destination": "https://documentation-liard-two.vercel.app/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "https://documentation-liard-two.vercel.app/llms-full.txt"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/og.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
