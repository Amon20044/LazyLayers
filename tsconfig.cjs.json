{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "dist-cjs"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "dist-cjs",
    "node_modules"
  ]
}
